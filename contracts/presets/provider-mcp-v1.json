{
  "format": 1,
  "providers": {
    "gemini": {
      "agentProvider": "gemini",
      "defaultModel": "model-two",
      "postInitScript": "printf \"%s\" \"$FIBE_PRESET_INPUT_TOKEN\"",
      "mcpConfig": {
        "mcpServers": {
          "local_fixture": {
            "command": "fixture-server",
            "args": [
              "--fixture"
            ],
            "env": {
              "TOKEN": "preset-fixture-token"
            }
          },
          "remote_fixture": {
            "serverUrl": "https://fixture-presets.test/mcp",
            "authHeader": "Bearer preset-fixture-token",
            "headers": {
              "User-Agent": "Fixture preset"
            }
          }
        }
      },
      "presetEnvironment": {
        "FIBE_PRESET_INPUT_TOKEN": "preset-fixture-token"
      }
    },
